	buttons {
		gpiobtn: gpiobtn {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>,
				<2 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb-typec {
		typec5v_pwren: typec5v-pwren {
			rockchip,pins = <4 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		usbc0_int: usbc0-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	lt6911 {
		lt6911_default: lt6911default {
			rockchip,pins = <1 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>,
				<2 RK_PC3 RK_FUNC_GPIO &pcfg_pull_down>,
				<1 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>,
				<3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	gpio-func {
		tsadc_gpio_func: tsadc-gpio-func {
			rockchip,pins = <0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb {
		vcc5v0_USB30_en: vcc5v0-USB30-en {
			rockchip,pins = <4 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	backlight_ctl {
		backlight_en: backlight-en {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	uart9 {
		uart9m0_rtsn: uart9m0-rtsn {
			rockchip,pins = <4 RK_PC4 10 &pcfg_pull_none>;
		};
		uart9m0_xfer: uart9m0-xfer {
			rockchip,pins = <2 RK_PC4 10 &pcfg_pull_up>,
				<2 RK_PC2 10 &pcfg_pull_up>;
		};
		uart9m0_ctsn: uart9m0-ctsn {
			rockchip,pins = <4 RK_PC5 10 &pcfg_pull_none>;
		};
	};
};

