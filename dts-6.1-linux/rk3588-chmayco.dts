/* ==== Armbian rk-6.1-rkr7.2 boot and status audit ==== */

&sdhci {
	status = "okay";
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
};

/* DP0 sound uses SPDIF TX2 in the factory DTB. */
&spdif_tx2 {
	status = "okay";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_cs0 &spi2m2_pins>;

	rk806single@0 {
		/* 本机 PMIC 差异：reset-func 用默认 1；DVS 引脚需要下拉 */
		pinctrl-names = "default", "pmic-power-off";
		pinctrl-0 = <&pmic_pins &rk806_dvs1_null &rk806_dvs2_null &rk806_dvs3_null>;
		pinctrl-1 = <&rk806_dvs1_pwrdn>;
		/* 与 rk3588-rk806-single.dtsi 的差异项 */
		low_voltage_threshold = <3000>;
		shutdown_voltage_threshold = <2700>;
		shutdown_temperture_threshold = <160>;
		hotdie_temperture_threshold = <115>;

		pinctrl_rk806 {
			gpio-controller;
			#gpio-cells = <0x02>;
			rk806_dvs3_null: rk806_dvs3_null {
				function = "pin_fun0";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs3_rst {
				function = "pin_fun3";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs1_null: rk806_dvs1_null {
				function = "pin_fun0";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs1_slp {
				function = "pin_fun1";
				pins = "gpio_pwrctrl1";
			};
			rk806_dvs2_null: rk806_dvs2_null {
				function = "pin_fun0";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs2_rst {
				function = "pin_fun3";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs2_gpio {
				function = "pin_fun5";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs3_gpio {
				function = "pin_fun5";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs2_slp {
				function = "pin_fun1";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs1_pwrdn: rk806_dvs1_pwrdn {
				function = "pin_fun2";
				pins = "gpio_pwrctrl1";
			};
			rk806_dvs1_rst {
				function = "pin_fun3";
				pins = "gpio_pwrctrl1";
			};
			rk806_dvs3_dvs {
				function = "pin_fun4";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs3_pwrdn {
				function = "pin_fun2";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs2_dvs {
				function = "pin_fun4";
				pins = "gpio_pwrctrl2";
			};
			rk806_dvs3_slp {
				function = "pin_fun1";
				pins = "gpio_pwrctrl3";
			};
			rk806_dvs2_pwrdn {
				function = "pin_fun2";
				pins = "gpio_pwrctrl2";
			};
		};

		regulators {
			vdd_gpu_s0: vdd_gpu_mem_s0: DCDC_REG1 {
				regulator-enable-ramp-delay = <0>;
			};

			vdd_cpu_lit_s0: vdd_cpu_lit_mem_s0: DCDC_REG2 {
				/delete-property/ regulator-init-microvolt;
			};

			vdd_log_s0: DCDC_REG3 {
				regulator-max-microvolt = <750000>;
			};
		};
	};
};

